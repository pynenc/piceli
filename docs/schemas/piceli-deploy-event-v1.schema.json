{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.pynenc.org/projects/piceli/en/latest/schemas/piceli-deploy-event-v1.schema.json",
  "title": "piceli deploy stdout line",
  "description": "One JSON line printed on stdout by `piceli deploy`: a stage event (with --json), the result, or a rejection. Fields are only added within a major version.",
  "anyOf": [
    {"$ref": "#/$defs/stage"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/rejection"}
  ],
  "$defs": {
    "stageName": {
      "enum": ["inputs", "build", "deliver", "plan", "apply", "checks"]
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage": {
      "type": "object",
      "required": ["schema", "event", "stage", "state", "at", "run_id"],
      "properties": {
        "schema": {"const": "piceli.deploy-event.v1"},
        "event": {"const": "stage"},
        "stage": {"$ref": "#/$defs/stageName"},
        "state": {
          "enum": ["planned", "running", "done", "skipped", "failed", "rejected", "interrupted"]
        },
        "at": {"type": "string"},
        "run_id": {"type": ["string", "null"]},
        "detail": {
          "type": "object",
          "description": "The stage's plan (state planned), output (done, skipped) or {\"reason\": <error code>} (failed, rejected)."
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["schema", "event", "state"],
      "properties": {
        "schema": {"const": "piceli.deploy-event.v1"},
        "event": {"const": "result"},
        "state": {
          "enum": [
            "planned",
            "approval-required",
            "ready",
            "stopped",
            "failed",
            "rolled-back",
            "interrupted",
            "rejected",
            "running"
          ]
        },
        "combined_hash": {"$ref": "#/$defs/hash"},
        "until": {"$ref": "#/$defs/stageName"},
        "run_id": {"type": "string"},
        "release": {"type": ["string", "null"]},
        "images": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "description": "The release's image set: image name to digest."
        },
        "stages": {
          "type": "object",
          "description": "With planned/approval-required: every stage's plan (a pending release plan adds `preview`, see #/$defs/preview). Otherwise: stage name to its state.",
          "propertyNames": {"$ref": "#/$defs/stageName"}
        },
        "refs": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
          "description": "With --ref (planned/approval-required): each pinned source's resolved commit SHA, which the combined hash covers."
        },
        "reason": {"type": "string", "description": "Error code (piceli explain <code>)."},
        "stage": {"$ref": "#/$defs/stageName"},
        "blocking": {"type": "array", "items": {"type": "object"}},
        "preview": {"$ref": "#/$defs/previewMarker"},
        "plan_file": {"type": "string", "description": "With --plan --out FILE (planned): the portable plan file written (piceli.deploy-plan-file.v1)."},
        "lock": {"$ref": "#/$defs/lock"},
        "summary": {
          "type": "object",
          "description": "Added in 0.8.0. A run that executed: its summary files under <state_dir>/runs/<run id>/ (summary.json follows piceli-run-summary-v1.schema.json; summary.md is for people and CI job summaries).",
          "required": ["json", "markdown"],
          "properties": {
            "json": {"type": "string"},
            "markdown": {"type": "string"}
          }
        },
        "cache": {
          "type": "object",
          "description": "Added in 0.8.0. With Pipeline(cache_budget=...): the state directory's size after the prune that follows the run.",
          "properties": {
            "budget_bytes": {"type": "integer"},
            "bytes": {"type": "integer"},
            "freed_bytes": {"type": "integer"},
            "over_budget": {"type": "boolean"}
          }
        }
      }
    },
    "lock": {
      "type": "object",
      "description": "With pipeline-locked: who holds the release lock and in how many seconds its lease expires unless renewed.",
      "required": ["holder"],
      "properties": {
        "holder": {"type": "string"},
        "expires_in": {"type": "integer", "minimum": 0}
      }
    },
    "rejection": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {"const": "rejected"},
        "reason": {"type": "string"},
        "stage": {"$ref": "#/$defs/stageName"},
        "blocking": {"type": "array", "items": {"type": "object"}},
        "preview": {"$ref": "#/$defs/previewMarker"},
        "lock": {"$ref": "#/$defs/lock"}
      }
    },
    "previewMarker": {
      "type": "object",
      "description": "Present when the refused or described release plan was a preview with placeholder images.",
      "required": ["approvable", "placeholders"],
      "properties": {
        "approvable": {"const": false},
        "placeholders": {
          "type": "object",
          "description": "Build image name to `pending-build` (not built) or `pending-delivery` (built, not delivered).",
          "additionalProperties": {"enum": ["pending-build", "pending-delivery"]}
        }
      }
    },
    "preview": {
      "description": "`stages.plan.preview` of a planned result whose release plan is `pending`: the release plan's structure and ownership computed with placeholder images. Never approvable; not covered by `combined_hash` except for its adopt/replace/delete set.",
      "allOf": [{"$ref": "#/$defs/previewMarker"}],
      "properties": {
        "state": {"const": "previewed"},
        "summary": {"type": "object", "additionalProperties": {"type": "integer"}},
        "changes": {"type": "array", "items": {"type": "object"}},
        "drift": {"type": "array", "items": {"type": "object"}},
        "authorized": {"type": "object"},
        "dry_run_skipped": {"type": "array", "items": {"type": "object"}},
        "dry_run_unavailable": {"type": "array", "items": {"type": "object"}},
        "preview_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
